@model CRUD_IATec.Application.DTOs.EstoqueDTO

@{
    ViewData["Title"] = "Deletar Estoque";
}

<h1>Deletar</h1>

<h3>Tem certeza que deseja deletar este item?</h3>
<div>
    <h4>Estoque</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NomeProduto)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NomeProduto)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quantidade)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantidade)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValorTotal)</dt>
        <dd class="col-sm-9">@Model.ValorTotal.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Deletar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>