@model CRUD_IATec.Application.DTOs.EstoqueDTO

@{
    ViewData["Title"] = "Detalhes do Estoque";
}

<h1>Detalhes</h1>

<div>
    <h4>Estoque</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NomeProduto)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NomeProduto)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quantidade)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantidade)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValorTotal)</dt>
        <dd class="col-sm-9">
            <strong>@Model.ValorTotal.ToString("C")</strong>
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmEstoque)</dt>
        <dd class="col-sm-9">
            @if (Model.EmEstoque)
            {
                <span class="badge bg-success">Disponível</span>
            }
            else
            {
                <span class="badge bg-danger">Esgotado</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>